      "core_concept": {
        "definition": "CPI 是每元实际成本获得的挣值。",
        "principle": "把挣值与取得这些工作所花的实际成本相比。",
        "syntax": "CPI=EV/AC；AC>0。",
        "rules": [
          "时点与金额单位必须一致。",
          "该比率没有金额单位。"
        ]
      },
      "cornell_note": {
